# Rules must not overlap: Cloudflare joins duplicate headers with a comma

# Pages and feeds
/
    Cache-Control: public, max-age=14400, must-revalidate

/:slug/
    Cache-Control: public, max-age=14400, must-revalidate

/*.xml
    Cache-Control: public, max-age=14400, must-revalidate

/robots.txt
    Cache-Control: public, max-age=14400, must-revalidate

/*.webm
    Cache-Control: public, max-age=14400, must-revalidate

# Assets referenced with a ?h= content hash
/*.css
    Cache-Control: public, max-age=31536000, immutable

/*.js
    Cache-Control: public, max-age=31536000, immutable

/*.png
    Cache-Control: public, max-age=31536000, immutable

/*.webp
    Cache-Control: public, max-age=31536000, immutable

# Referenced from CSS without a hash: rename the file if it ever changes
/*.woff2
    Cache-Control: public, max-age=31536000, immutable

/rss.xml
    Content-Type: application/rss+xml
